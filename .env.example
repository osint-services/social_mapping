# Browser client. Never put secrets in a VITE_* variable.
VITE_API_BASE_URL=http://localhost:8000

# Internal API providers.
DATASET_SERVICE_URL=http://localhost:8001
TWEEPY_BEARER_TOKEN=

# Investigator-entered place resolver.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=social-mapping/1.0 (+https://github.com/osint-services/social_mapping)
GEOCODER_CACHE_PATH=.data/geocoder-cache.db
GEOCODER_CACHE_DAYS=30
GEOCODER_MIN_INTERVAL_SECONDS=1
PROVIDER_TIMEOUT_SECONDS=15
